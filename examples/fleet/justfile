# 実機の構成を管理するリポジトリの justfile(agent-host-autoinstall の examples/fleet から作ったもの)。
# 道具(agent-host-autoinstall)は tool/ に submodule で、リリースのタグに固定して置く。手順は tool/docs/fleet.md
set shell := ["bash", "-euo", "pipefail", "-c"]
set windows-shell := ["C:/Program Files/Git/bin/bash.exe", "-euo", "pipefail", "-c"]

tool := "tool/justfile"

# この構成の版。作ったホストの /opt/agent-host/BUILD-INFO に残る(just status で見える)
export AGENT_HOST_CONFIG_REV := `git describe --always --dirty 2>/dev/null || echo 不明`

_default:
    @just --list --unsorted

# 道具を取得する(clone したあとに 1 回)。Ubuntu の ISO も取得する
setup:
    git submodule update --init
    just -f {{tool}} fetch-iso

# ホストの env.yaml(common.yaml + hosts/<ホスト>.yaml)を検査する
check host:
    scripts/with-env.sh {{host}} just -f {{tool}} check-env

# すべてのホストの env.yaml を検査する(道具の版を上げたときに)
check-all:
    for f in hosts/*.yaml; do just check "$(basename "$f" .yaml)"; done

# age の鍵のファイル 1 つだけで、暗号化したすべてのファイルを復号できるかを確かめる(回復用の鍵や、足した人の鍵の確認に)。
# sops は SOPS_AGE_KEY_FILE を渡しても手元の keys.txt も読むので、既定の置き場所を空のディレクトリに向けて、渡した鍵だけを使わせる
check-age-key keyfile:
    mkdir -p build/.nokeys
    rc=0; for f in common.yaml hosts/*.yaml; do grep -q '^sops:' "$f" || continue; if env -u SOPS_AGE_KEY APPDATA="$PWD/build/.nokeys" XDG_CONFIG_HOME="$PWD/build/.nokeys" SOPS_AGE_KEY_FILE="{{keyfile}}" sops --decrypt "$f" >/dev/null 2>&1; then echo "復号できる: $f"; else echo "復号できない: $f"; rc=1; fi; done; exit $rc

# インストール用の ISO を build/<ホスト>.iso に作る(秘密情報が入る。USB に書き込んだら消す)
iso host:
    scripts/with-env.sh {{host}} just -f {{tool}} iso build/{{host}}.iso

# 設定とスクリプトの変更をホストに反映する(target はつなぐ先。名前で引けなければ IP を渡す)
update host target=host:
    scripts/with-env.sh {{host}} just -f {{tool}} update {{target}}

# ホストの状態と、置いた版・最後に適用に成功した版を見る
status target:
    just -f {{tool}} status {{target}}

# 仕様どおりに構成されているかを確かめる(読むだけ。✗ があれば失敗する)
verify target:
    just -f {{tool}} verify {{target}}

# ホストの env.yaml の users で、利用者ごとに RDP の認証が通るかを確かめる(画面は開かない)。
# 本人が変えたパスワードで確かめるなら ask に利用者の名前を書く(例: just verify-rdp agent-host-01 ask=alice)
verify-rdp host target=host ask="":
    scripts/with-env.sh {{host}} just -f {{tool}} verify-rdp {{target}} {{ if ask != "" { "--ask " + ask } else { "" } }}

# 台帳のための情報を facts/<ホスト>.yaml に書く(コミットする。秘密情報は入らない)
facts host target=host:
    mkdir -p facts
    just -f {{tool}} facts {{target}} | sed '/^$/d' > facts/{{host}}.yaml
    @echo "書いた: facts/{{host}}.yaml"

# 構成・利用者ごとの first-login とセッションの記録を見る
logs target:
    just -f {{tool}} logs {{target}}

# sysadmin で SSH する
ssh target:
    just -f {{tool}} ssh {{target}}

# 利用者の RDP の接続ファイルを build/<ホスト>-<ポート>.rdp に作る(ポートとユーザーは hosts/<ホスト>.yaml の users の port と rdp.username)
rdp target port="3389" user="":
    just -f {{tool}} rdp {{target}} {{port}} '{{user}}'
    mkdir -p build && mv -f tool/build/{{target}}-{{port}}.rdp build/
    @echo "移した: build/{{target}}-{{port}}.rdp"

# 移行の書き出し(ログインの情報が入るので、out はこのリポジトリの外の暗号化された場所にする)
backup target out:
    just -f {{tool}} backup {{target}} {{out}}

# 移行の取り込み(構成が終わったホストに)
restore target file:
    just -f {{tool}} restore {{target}} {{file}}
