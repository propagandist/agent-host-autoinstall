#!/usr/bin/env bash
# agent の GNOME のセッションが落ちてログイン画面のままになっていたら、GDM を再起動して自動ログインさせる。
# agent-host-session-watchdog.timer から 1 分ごとに呼ばれる。2 回続けて(約 2 分)ログイン画面のままなら再起動する。
# GDM の自動ログインは起動時の 1 回だけで、TimedLogin は agent がログイン画面の一覧に出ないので効かなかった(VirtualBox)。
set -euo pipefail

agent=agent
state=/run/agent-host-session-watchdog.missed

# seat0 にログインのセッション(CLASS が user)が 1 つでもあれば何もしない(管理者が画面から入っているときも含む)
if loginctl list-sessions --no-legend | awk '$4 == "seat0" && $6 == "user"' | grep -q .; then
    rm -f "$state"
    exit 0
fi
# GDM が動いていなければ(起動の途中や、構成サービスの実行中など)何もしない
systemctl is-active --quiet gdm.service || exit 0

if [ ! -f "$state" ]; then
    touch "$state"
    exit 0
fi
rm -f "$state"
echo "[agent-host] $agent のセッションがないので GDM を再起動する"
systemctl restart gdm.service
# 落ち続けるときに通知があふれないよう、知らせるのは 1 時間に 1 回まで
notified=/var/lib/agent-host/session-watchdog.notified
if [ -z "$(find "$notified" -mmin -60 2>/dev/null)" ]; then
    mkdir -p "$(dirname "$notified")"
    touch "$notified"
    /usr/local/bin/agent-notify error "セッションを復旧した" \
        "$agent の GNOME のセッションが落ちてログイン画面のままだったので、GDM を再起動して自動ログインさせた" || true
fi
