# agent-host-autoinstall(64-llm.sh)が置くローカル LLM のサーバー。env.yaml の llm.mode が local のときだけ動かす
[Unit]
Description=Ollama(ローカル LLM。agent-host-autoinstall)
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=ollama
Group=ollama
# GPU(/dev/dri・/dev/kfd)を使えるように。NVIDIA は /dev/nvidia* が誰でも開ける
SupplementaryGroups=render video
# HTTP プロキシと CA 証明書(05-proxy-ca.sh。モデルの取得に使う)
EnvironmentFile=-/etc/environment
# このホストの中だけで待ち受ける(LAN には開けない)
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/var/lib/ollama/models
# ollama.com のクラウドのモデルと Web 検索を使わない(コードを外に出さない)
Environment=OLLAMA_NO_CLOUD=1
# 同時に載せるモデルは 1 つ、同時の要求も 1 つ(メモリを利用者のセッションに残す)
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
EnvironmentFile=/etc/agent-host/ollama.env
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=3
# 利用者のセッション(gnome-shell・Orca・エージェント)を優先する。上限を超えたら Ollama だけが落ちて立ちなおる
MemoryMax=50%
MemorySwapMax=0
CPUWeight=50
IOWeight=50

[Install]
WantedBy=multi-user.target
