[Unit]
Description=agent-host の構成(post-install を番号順に実行)
Wants=network-online.target
After=network-online.target
# 構成が終わってから GDM を起動し、agent の自動ログインへ進む
Before=display-manager.service
# 一度成功したら次の起動からは動かない。再実行は sudo /opt/agent-host/provision.sh
ConditionPathExists=!/var/lib/agent-host/provisioned

[Service]
Type=oneshot
# 起動画面(plymouth)を閉じ、構成の進み具合をコンソールに出す。閉じないと、構成のあいだ(初回は 20 分ほど)CPU を使い続け、
# GDM が起動するときに異常終了して plymouth-start.service が failed で残った(VirtualBox で確認)
ExecStartPre=-/usr/bin/plymouth quit
ExecStart=/opt/agent-host/provision.sh
RemainAfterExit=yes
TimeoutStartSec=0
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
