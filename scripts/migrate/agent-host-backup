#!/usr/bin/env bash
# 環境を入れ替えるときに移すもの(ホストの身元、ログインと設定、作業中のもの)を tar にまとめて標準出力に書く。
# ホストには保存しない。使い方(手元の PC で。sudo のパスワードを標準入力の先頭の 1 行で渡す):
#   read -rsp "sysadmin のパスワード: " PW; echo
#   printf '%s\n' "$PW" | ssh sysadmin@<ホスト> 'sudo -S -p "" agent-host-backup' > agent-host-<ホスト名>-<日付>.tar.zst
# 取り込みは agent-host-restore。書き出しにはログインの情報が入るので、暗号化された場所に置き、取り込んだら消す。
# 利用者(env.yaml の users)全員のホームの分を書き出す。ホームの分は利用者の権限で読む(root で読むと、
# 利用者が置いたリンクをたどって、利用者に読めない root のファイルまで書き出してしまう。Issue #23)。
# 書き出しは、root の tar(記録とホストの身元)のあとに、利用者ごとの tar を続けたもの(読むときは tar -i)。
# 作りなおせるもの(ツールの本体、mise の言語、Docker のイメージ、Chrome のプロファイル、~/work の中の
# node_modules・__pycache__・.venv、Orca のキャッシュ)は含めない。
set -euo pipefail
# shellcheck source=../lib/common.sh
. /opt/agent-host/lib/common.sh

[ "$(id -u)" -eq 0 ] || { echo "root で実行する(sudo agent-host-backup)" >&2; exit 2; }
[ -t 1 ] && { echo "標準出力をファイルに向ける: ssh ... 'sudo agent-host-backup' > backup.tar.zst" >&2; exit 2; }
load_env

# --- 移すもの(/ からの相対パス。ないものは飛ばす) ---
paths=(
    # ホストの身元: SSH のホスト鍵(変わると接続する全員に警告が出る)
    etc/ssh/ssh_host_ecdsa_key etc/ssh/ssh_host_ecdsa_key.pub
    etc/ssh/ssh_host_ed25519_key etc/ssh/ssh_host_ed25519_key.pub
    etc/ssh/ssh_host_rsa_key etc/ssh/ssh_host_rsa_key.pub
)
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
: >"$work/users"
add_user_paths() {
    local home="${AGENT_HOME#/}" upaths anchored_excludes
    printf 'uid.%s=%s\nhome.%s=%s\n' "$AGENT_USER" "$(id -u "$AGENT_USER")" "$AGENT_USER" "$home" >>"$work/users"
    upaths=(
        # ホストの身元: RDP の TLS 証明書(変わると RDP の証明書の警告が出る)と、認証情報(TPM がないとき。
        # 本人が変えたパスワードをそのまま運ぶ)
        "$home/.local/share/gnome-remote-desktop"
        # ログインキーリング(アプリが保存したログイン)
        "$home/.local/share/keyrings"
        # エージェントのログインと設定
        "$home/.claude" "$home/.claude.json" "$home/.codex" "$home/.copilot" "$home/.gemini"
        "$home/.config/opencode" "$home/.local/share/opencode"
        "$home/.config/gh" "$home/.docker/config.json" "$home/.ssh" "$home/.gitconfig"
        # Gitea CLI(tea)のログイン、クラウドの CLI のログインと設定、mise の全体の設定(Issue #7)
        "$home/.config/tea" "$home/.aws" "$home/.config/gcloud" "$home/.azure" "$home/.config/mise"
        # Orca の設定と状態、エディター・端末・日本語入力の設定、シェルの履歴
        "$home/.config/orca" "$home/.orca"
        "$home/.config/Code/User" "$home/.config/zed" "$home/.config/xfce4" "$home/.config/mozc"
        "$home/.bash_history"
        # 作業中のもの(push していない変更を含む。Orca の worktree もこの下)
        "$home/work"
    )
    # 作りなおせるもの・キャッシュは除く。名前だけで除くと、同じ名前の原本のディレクトリ・ファイルや、git の ref
    # (dist や target という名前のブランチ)まで消える(Issue #4)。そこで、
    #   - Orca(Electron)のキャッシュは、Orca の設定ディレクトリの中に固定したパターンで除く
    #   - ~/work の中は、依存のパッケージ・Python のバイトコード・仮想環境のディレクトリ(node_modules、__pycache__、.venv)を
    #     実際に探し、見つけたパスだけを除く。.git の中は見ない。dist・target・.cache などのビルドの出力は除かない
    anchored_excludes=(
        "$home/.config/orca/*Cache" "$home/.config/orca/Crashpad" "$home/.config/orca/*Shared Dictionary"
        "$home/.config/gcloud/logs"
    )
    printf '%s\n' "${anchored_excludes[@]}" >"$work/anchored.$AGENT_USER"
    # あるものを確かめるのも、~/work の中を探すのも利用者の権限で行う
    # shellcheck disable=SC2016  # 利用者の sh の中で展開する
    agent_run sh -c 'for p; do [ -e "/$p" ] && printf "%s\n" "$p"; done; true' sh "${upaths[@]}" >"$work/paths.$AGENT_USER"
    : >"$work/exclude.$AGENT_USER"
    if agent_run test -d "/$home/work"; then
        agent_run find "/$home/work" -path '*/.git' -prune -o -type d \( -name node_modules -o -name __pycache__ -o -name .venv \) \
            -print -prune 2>/dev/null | sed 's|^/||' >"$work/exclude.$AGENT_USER" || true
    fi
    # 利用者に読めないもの(rootless Docker のコンテナが作ったデータなど)は、tar が途中で止まらないよう先に見つけて除き、
    # 記録に残して知らせる。リンクはリンクとして書庫に入る(たどらない)ので見ない
    local p found=()
    while IFS= read -r p; do found+=("/$p"); done <"$work/paths.$AGENT_USER"
    : >"$work/unreadable.$AGENT_USER"
    if [ "${#found[@]}" -gt 0 ]; then
        agent_run find "${found[@]}" ! -type l \( ! -readable -o -type d ! -executable \) -print -prune 2>/dev/null |
            sed 's|^/||' >"$work/unreadable.$AGENT_USER" || true
    fi
}
for_each_user add_user_paths

existing=()
for p in "${paths[@]}"; do
    [ -e "/$p" ] && existing+=("$p")
done

{
    echo "# agent-host-backup の記録"
    echo "hostname=$(hostname)"
    echo "date=$(date -Is)"
    cat "$work/users"
    for pkg in claude-code orca-ide docker-ce code gh google-chrome-stable; do
        echo "pkg.$pkg=$(dpkg-query -W -f='${Version}' "$pkg" 2>/dev/null || echo none)"
    done
    echo "node=$(node --version 2>/dev/null || echo none)"
    echo "codex=$(codex --version 2>/dev/null || echo none)"
    [ "${#existing[@]}" -eq 0 ] || printf 'path=%s\n' "${existing[@]}"
    cat "$work"/paths.* | sed 's/^/path=/'
    cat "$work"/exclude.* | sed 's/^/excluded=/'
    cat "$work"/unreadable.* | sed 's/^/unreadable=/'
} >"$work/agent-host-manifest.txt"

# 利用者ごとの tar を標準出力に書く。利用者の権限で読むので、利用者に読めないものは入らない。
# Orca のキャッシュと gcloud の記録はパターン(先頭から合わせる)、~/work の中は見つけたパスそのもの(ワイルドカードとして読まない)で除く。
# 一覧は root だけが読める場所にあるので、書き出すものは引数で、除くもの(~/work の中と、読めないもの)は標準入力で渡す。
# 1 人の tar が失敗しても、ほかの人の分は書く(終了コードは $work/rc に残し、最後に返す)
write_user_tar() {
    local exclude_args=(--anchored) e upaths rc=0
    mapfile -t upaths <"$work/paths.$AGENT_USER"
    [ "${#upaths[@]}" -gt 0 ] || return 0
    while IFS= read -r e; do
        exclude_args+=("--exclude=$e")
    done <"$work/anchored.$AGENT_USER"
    exclude_args+=(--no-wildcards --exclude-from=-)
    # Orca などが使っているソケットは tar が飛ばす(移す必要もない)ので、その警告は出さない
    cat "$work/exclude.$AGENT_USER" "$work/unreadable.$AGENT_USER" |
        agent_run tar --warning=no-file-ignored -cf - -C / "${exclude_args[@]}" "${upaths[@]}" || rc=$?
    if [ "$rc" -ne 0 ]; then
        echo "[agent-host] 注意: $AGENT_USER の書き出しで tar が $rc で終わった(1 は読んでいる間に変わったファイルがあった)" >&2
        [ "$rc" -le "$(cat "$work/rc")" ] || echo "$rc" >"$work/rc"
    fi
}
manifest="$work/agent-host-manifest.txt"
echo "[agent-host] 書き出す: $(grep -c '^path=' "$manifest") か所(ホスト $(hostname))。~/work から除くもの: $(grep -c '^excluded=' "$manifest" || true) か所" >&2
if grep -q '^unreadable=' "$manifest"; then
    echo "[agent-host] 注意: 利用者に読めないので書き出さないもの(移すなら、読めるようにしてから書き出しなおす):" >&2
    sed -n 's/^unreadable=/  \//p' "$manifest" >&2
fi
echo 0 >"$work/rc"
{
    if [ "${#existing[@]}" -gt 0 ]; then
        tar -cf - -C "$work" agent-host-manifest.txt -C / "${existing[@]}"
    else
        tar -cf - -C "$work" agent-host-manifest.txt
    fi
    for_each_user write_user_tar
} | zstd -q -c
rc="$(cat "$work/rc")"
[ "$rc" -eq 0 ] || { echo "[agent-host] 書き出しは終わったが、tar の終了コードが $rc だった(上の注意を見る)" >&2; exit "$rc"; }
echo "[agent-host] 書き出しが終わった" >&2
